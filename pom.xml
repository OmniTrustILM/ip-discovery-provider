<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.otilm</groupId>
		<artifactId>dependencies</artifactId>
		<version>2.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>ip-discovery-provider</artifactId>
	<version>1.7.0-SNAPSHOT</version>
	<name>ip-discovery-provider</name>
	<description>Certificate Discovery Connector for ILM based on IP address range and ports</description>

	<properties>
		<java.version>21</java.version>
		<ipaddress.version>5.6.2</ipaddress.version>
		<sonar.organization>ilm</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.projectKey>ilm_ip-discovery-provider</sonar.projectKey>
		<!-- Excluded from coverage only where there is no branching logic to assert, or where a live
		     database is required. Everything carrying real logic stays in - notably config/** and
		     enums/**, which the sibling connectors exclude but which are tested here. -->
		<sonar.coverage.exclusions>
			<!-- Spring Boot bootstrap: main() and nothing else -->
			src/main/java/com/otilm/discovery/ip/Application.java,
			<!-- AOP aspect that only executes at DEBUG, and logs rather than decides -->
			src/main/java/com/otilm/discovery/ip/LoggingAdvice.java,
			<!-- exception-to-status mappings; the catch-all logs and returns a fixed body -->
			src/main/java/com/otilm/discovery/ip/ExceptionHandlingAdvice.java,
			<!-- Controllers that only delegate to a service. The rest of api/v2 is measured: those build the
			     interface list and validate their arguments, which is logic a test has to protect. -->
			src/main/java/com/otilm/discovery/ip/api/*.java,
			src/main/java/com/otilm/discovery/ip/api/v2/AttributesControllerImpl.java,
			src/main/java/com/otilm/discovery/ip/api/v2/DiscoveryOperationControllerImpl.java,
			<!-- JPA entities and their accessors -->
			src/main/java/com/otilm/discovery/ip/dao/**,
			<!-- data holder -->
			src/main/java/com/otilm/discovery/ip/dto/**,
			<!-- Flyway Java migration: needs a populated database to exercise -->
			src/main/java/db/migration/**
		</sonar.coverage.exclusions>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.otilm</groupId>
			<artifactId>interfaces</artifactId>
			<version>2.20.0-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Serves the v2 metrics interface. The contract's endpoint is the Prometheus scrape itself, so this
		     registry is the implementation and there is no controller class. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TestRestTemplate builds on RestTemplateBuilder, which the test module leaves to the application. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-metrics-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Test scope only: no main code uses BouncyCastle and no provider is registered.
		     DiscoveryScanIntegrationTest uses it to mint the certificate its TLS endpoint serves. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- https://mvnrepository.com/artifact/commons-net/commons-net -->
		<dependency>
			<groupId>commons-net</groupId>
			<artifactId>commons-net</artifactId>
		</dependency>

		<dependency>
			<groupId>com.github.seancfoley</groupId>
			<artifactId>ipaddress</artifactId>
			<version>${ipaddress.version}</version>
		</dependency>

		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.awaitility</groupId>
			<artifactId>awaitility</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<packagingExcludes>
						**/META-INF/maven/**,
					</packagingExcludes>
					<archive>
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<executable>true</executable>
				</configuration>
				<executions>
					<execution>
						<!-- Generates build-info.properties, which backs the BuildProperties bean the v2 info
						     endpoint reports its version from. -->
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine}</argLine>
					<systemPropertyVariables>
						<!-- Adds src/test/resources/application-test.yml, which overrides only what a test cannot
						     use. The shipped application.yml stays the base, so a suite that passes has exercised
						     the configuration that ships. Included rather than activated: @ActiveProfiles replaces
						     the active list, and several tests set their own. -->
						<spring.profiles.include>test</spring.profiles.include>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>

			<!-- Flyway Java migrations report the checksum recorded in JavaMigrationChecksums, and
			     DatabaseMigrationTest holds that value to the migration's source text. A shipped migration is a
			     contract with every database that ran it, not ordinary source, so both gates skip them. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<configuration>
					<java>
						<excludes>
							<exclude>src/main/java/db/migration/**/*.java</exclude>
						</excludes>
					</java>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<configuration>
					<excludes>db/migration/**/*.java</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>github</id>
			<url>https://maven.pkg.github.com/omnitrustilm/*</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>central-portal</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
		</repository>
	</repositories>

</project>
